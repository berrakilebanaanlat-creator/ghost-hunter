/**
 * Frekans Tarayıcı (Frequency Scanner) - Antik Ghost Hunter
 * v3.0 - Ses Deneyimi Tamamen Yeniden Tasarlandı
 *
 * SES SİSTEMİ:
 * 1. Kesintisiz beyaz gürültü (static_loop.mp3 - sürekli loop, düşük volüm)
 * 2. Frekans geçiş sesi (sweep_transition.mp3 - frekans değişirken "vışş")
 * 3. Kelime harmanı:
 *    - %40 belirsiz kelimeler (çok düşük pitch, hızlı, yarım kesilmiş)
 *    - %35 yarı-anlaşılır kelimeler (orta pitch, fısıltı tarzı)
 *    - %25 net kelimeler (normal pitch, yavaş, açık)
 *
 * TARAMA AKIŞI:
 * - Beyaz gürültü sürekli akar (rahatsız etmeyen tonda)
 * - Frekans değiştikçe sweep sesi gelir
 * - 8-45sn rastgele aralıklarla kelimeler belirir
 * - Kelimeler gürültünün içinden çıkıyormuş gibi hissedilir
 *
 * Gerekli ses dosyaları (assets/sounds/):
 *   - static_loop.mp3 (beyaz gürültü - loop, 10-30sn uzunluk)
 *   - sweep_transition.mp3 (frekans geçiş sesi - 1-2sn)
 *
 * Bağımlılık: expo-speech (pnpm add expo-speech)
 */

import React, { useState, useEffect, useRef, useCallback } from "react";
import {
  View,
  Text,
  ScrollView,
  Pressable,
  StyleSheet,
  Dimensions,
  Platform,
  Animated,
  Easing,
} from "react-native";
import { ScreenContainer } from "@/components/screen-container";
import { useAudioPlayer, setAudioModeAsync } from "expo-audio";
import * as Speech from "expo-speech";
import * as Haptics from "expo-haptics";

// ─── TYPES ───────────────────────────────────────────────────────────────────

type Band = "AM" | "FM";
type ScanState = "idle" | "scanning" | "detected";
type WordClarity = "unclear" | "semi" | "clear";

interface Detection {
  id: string;
  word: string;
  frequency: number;
  band: Band;
  strength: number;
  clarity: WordClarity;
  timestamp: number;
}

// ─── KELİME BANKASI ─────────────────────────────────────────────────────────
// 3 katman: belirsiz (hızlı geçen, yarım), yarı-anlaşılır (fısıltı), net (açık)

// Belirsiz kelimeler - çok kısa, yarım kesilecek, anlaşılması zor
const UNCLEAR_WORDS: string[] = [
  "bur...", "ge...", "ka...", "ar...", "gö...",
  "se...", "du...", "yar...", "so...", "ne...",
  "ah", "şş", "hh", "mm", "of",
  "tık", "çat", "vız", "hış", "kk",
  "...dım", "...yor", "...mış", "...sin", "...lar",
  "b-bak", "g-gel", "k-kim", "d-dur", "s-sus",
];

// Yarı-anlaşılır kelimeler - fısıltı, belirsiz ama ipucu veren
const SEMI_WORDS: string[] = [
  "burada", "arkanda", "dinle", "sessiz", "soğuk",
  "karanlık", "gölge", "kapı", "ayna", "rüzgar",
  "geliyor", "gidiyor", "bekle", "uyan", "hatırla",
  "yalnız", "kayıp", "ışık", "derin", "eski",
  "seni...gör", "bura...soğ", "gel...yan", "duy...be",
  "kim...sin", "ne...isti", "nere...de", "za...man",
];

// Net kelimeler - açık ve anlaşılır, ürkütücü
const CLEAR_WORDS: string[] = [
  "buradayım", "seni görüyorum", "arkana bak",
  "yardım et", "gitme", "beni duy",
  "yalnız değilsin", "korku", "yaklaşıyorum",
  "kapıyı aç", "kim var orada", "sessiz ol",
  "geçmişten geliyorum", "unutma beni", "zaman doldu",
  "dikkat et", "tehlike var", "kaçma",
  "affet beni", "özledim seni", "eve dön",
];

// ─── CONSTANTS ───────────────────────────────────────────────────────────────

const { width: SCREEN_WIDTH } = Dimensions.get("window");

const BANDS = {
  AM: { min: 530, max: 1700, unit: "kHz", step: 10 },
  FM: { min: 87.5, max: 108.0, unit: "MHz", step: 0.1 },
};

// Rastgele aralıklar (ms) - 8sn ile 45sn arası
const DETECTION_INTERVALS = {
  unclear: [3000, 5000, 7000, 8000, 10000, 12000],        // Belirsiz: daha sık
  semi: [10000, 15000, 18000, 22000, 25000, 28000],       // Yarı: orta sıklık
  clear: [25000, 30000, 35000, 38000, 42000, 45000],      // Net: nadir
};

// TTS ses profilleri - kelime netliğine göre
const VOICE_PROFILES = {
  unclear: [
    { pitch: 0.2, rate: 2.0, volume: 0.3 },  // Çok hızlı, derin, kısık
    { pitch: 1.8, rate: 1.8, volume: 0.25 },  // Tiz, hızlı, kısık
    { pitch: 0.3, rate: 1.5, volume: 0.35 },  // Derin, hızlıca
    { pitch: 1.5, rate: 2.0, volume: 0.2 },   // Tiz, çok hızlı, çok kısık
  ],
  semi: [
    { pitch: 0.4, rate: 0.6, volume: 0.55 },  // Derin fısıltı
    { pitch: 0.6, rate: 0.7, volume: 0.5 },   // Orta fısıltı
    { pitch: 1.3, rate: 0.5, volume: 0.45 },  // Tiz fısıltı, yavaş
    { pitch: 0.5, rate: 0.8, volume: 0.6 },   // Derin, orta hız
  ],
  clear: [
    { pitch: 0.3, rate: 0.4, volume: 0.85 },  // Çok derin, yavaş, net
    { pitch: 0.7, rate: 0.5, volume: 0.8 },   // Orta derin, yavaş
    { pitch: 1.0, rate: 0.6, volume: 0.75 },  // Normal, yavaşça
    { pitch: 0.5, rate: 0.3, volume: 0.9 },   // Derin, çok yavaş (en ürkütücü)
  ],
};

// ─── COMPONENT ───────────────────────────────────────────────────────────────

export default function FrequencyScanner() {
  // State
  const [band, setBand] = useState<Band>("FM");
  const [frequency, setFrequency] = useState<number>(BANDS.FM.min);
  const [scanState, setScanState] = useState<ScanState>("idle");
  const [signalStrength, setSignalStrength] = useState<number>(0);
  const [detections, setDetections] = useState<Detection[]>([]);
  const [currentWord, setCurrentWord] = useState<string>("");
  const [currentClarity, setCurrentClarity] = useState<WordClarity>("unclear");
  const [elapsedTime, setElapsedTime] = useState<number>(0);
  const [noiseLevel, setNoiseLevel] = useState<number>(0.3); // Beyaz gürültü seviyesi

  // Refs
  const scanIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const timerIntervalRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const detectionTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const unclearTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const isScanningRef = useRef(false);

  // Animations
  const pulseAnim = useRef(new Animated.Value(1)).current;
  const glowAnim = useRef(new Animated.Value(0)).current;
  const noiseAnim = useRef(new Animated.Value(0.3)).current;
  const wordFadeAnim = useRef(new Animated.Value(0)).current;
  const sweepAnim = useRef(new Animated.Value(0)).current;

  // Audio players
  const staticPlayer = useAudioPlayer(
    require("@/assets/sounds/static_loop.mp3")
  );
  const sweepPlayer = useAudioPlayer(
    require("@/assets/sounds/sweep_transition.mp3")
  );

  // ─── AUDIO SETUP ────────────────────────────────────────────────────────────

  useEffect(() => {
    setAudioModeAsync({ playsInSilentModeIOS: true });
    return () => {
      staticPlayer.release();
      sweepPlayer.release();
      Speech.stop();
    };
  }, []);

  // ─── ANIMATIONS ─────────────────────────────────────────────────────────────

  useEffect(() => {
    if (scanState === "scanning" || scanState === "detected") {
      Animated.loop(
        Animated.sequence([
          Animated.timing(pulseAnim, {
            toValue: 1.015,
            duration: 1500,
            easing: Easing.inOut(Easing.ease),
            useNativeDriver: true,
          }),
          Animated.timing(pulseAnim, {
            toValue: 1,
            duration: 1500,
            easing: Easing.inOut(Easing.ease),
            useNativeDriver: true,
          }),
        ])
      ).start();

      // Gürültü titreşimi - sürekli
      Animated.loop(
        Animated.sequence([
          Animated.timing(noiseAnim, {
            toValue: 0.5 + Math.random() * 0.3,
            duration: 60 + Math.random() * 120,
            useNativeDriver: true,
          }),
          Animated.timing(noiseAnim, {
            toValue: 0.2 + Math.random() * 0.2,
            duration: 60 + Math.random() * 120,
            useNativeDriver: true,
          }),
        ])
      ).start();
    } else {
      pulseAnim.setValue(1);
      noiseAnim.setValue(0.3);
    }
  }, [scanState]);

  // ─── SWEEP SOUND (Frekans geçiş sesi) ─────────────────────────────────────

  const playSweep = useCallback(() => {
    try {
      sweepPlayer.seekTo(0);
      sweepPlayer.volume = 0.15 + Math.random() * 0.1;
      sweepPlayer.play();
    } catch (e) {}

    // Sweep animasyonu
    Animated.sequence([
      Animated.timing(sweepAnim, {
        toValue: 1,
        duration: 150,
        useNativeDriver: true,
      }),
      Animated.timing(sweepAnim, {
        toValue: 0,
        duration: 400,
        useNativeDriver: true,
      }),
    ]).start();
  }, []);

  // ─── SPEECH (TTS) - Kelime netliğine göre farklı ses ──────────────────────

  const speakWord = useCallback((word: string, clarity: WordClarity) => {
    const profiles = VOICE_PROFILES[clarity];
    const profile = profiles[Math.floor(Math.random() * profiles.length)];

    Speech.speak(word, {
      language: "tr-TR",
      pitch: profile.pitch,
      rate: profile.rate,
      volume: profile.volume,
      onDone: () => {
        // Net kelimeler yavaş kaybolur, belirsizler hızlı
        const fadeDuration = clarity === "clear" ? 3000 : clarity === "semi" ? 1500 : 500;
        Animated.timing(wordFadeAnim, {
          toValue: 0,
          duration: fadeDuration,
          useNativeDriver: true,
        }).start(() => {
          setCurrentWord("");
        });
      },
    });

    setCurrentWord(word);
    setCurrentClarity(clarity);

    // Fade in hızı netliğe göre
    const fadeInDuration = clarity === "clear" ? 400 : clarity === "semi" ? 250 : 100;
    Animated.timing(wordFadeAnim, {
      toValue: clarity === "clear" ? 1 : clarity === "semi" ? 0.7 : 0.4,
      duration: fadeInDuration,
      useNativeDriver: true,
    }).start();
  }, []);

  // ─── DETECTION LOGIC ────────────────────────────────────────────────────────

  const pickClarity = useCallback((): WordClarity => {
    const rand = Math.random();
    if (rand < 0.40) return "unclear";    // %40 belirsiz
    if (rand < 0.75) return "semi";       // %35 yarı-anlaşılır
    return "clear";                        // %25 net
  }, []);

  const getWordForClarity = useCallback((clarity: WordClarity): string => {
    const bank = clarity === "clear" ? CLEAR_WORDS
      : clarity === "semi" ? SEMI_WORDS
      : UNCLEAR_WORDS;
    return bank[Math.floor(Math.random() * bank.length)];
  }, []);

  const getIntervalForClarity = useCallback((clarity: WordClarity): number => {
    const intervals = DETECTION_INTERVALS[clarity];
    return intervals[Math.floor(Math.random() * intervals.length)];
  }, []);

  const triggerDetection = useCallback(() => {
    if (!isScanningRef.current) return;

    const clarity = pickClarity();
    const word = getWordForClarity(clarity);
    const strength = clarity === "clear" ? 60 + Math.floor(Math.random() * 40)
      : clarity === "semi" ? 30 + Math.floor(Math.random() * 40)
      : 10 + Math.floor(Math.random() * 25);

    // Frekansı kilitle
    const paranormalFreq = band === "FM"
      ? +(87.5 + Math.random() * 20.5).toFixed(1)
      : Math.round(530 + Math.random() * 1170);

    setFrequency(paranormalFreq);
    setSignalStrength(strength);

    // Sadece net kelimeler "detected" state'ine geçer
    if (clarity === "clear") {
      setScanState("detected");
    }

    // Haptic - netliğe göre
    if (Platform.OS !== "web") {
      if (clarity === "clear") {
        Haptics.notificationAsync(Haptics.NotificationFeedbackType.Warning);
      } else if (clarity === "semi") {
        Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
      }
      // unclear: haptic yok
    }

    // Kelimeyi seslendir
    speakWord(word, clarity);

    // Glow - sadece semi ve clear
    if (clarity !== "unclear") {
      const glowIntensity = clarity === "clear" ? 1 : 0.4;
      Animated.sequence([
        Animated.timing(glowAnim, {
          toValue: glowIntensity,
          duration: 200,
          useNativeDriver: true,
        }),
        Animated.timing(glowAnim, {
          toValue: glowIntensity * 0.3,
          duration: 400,
          useNativeDriver: true,
        }),
        Animated.timing(glowAnim, {
          toValue: glowIntensity * 0.6,
          duration: 200,
          useNativeDriver: true,
        }),
        Animated.timing(glowAnim, {
          toValue: 0,
          duration: clarity === "clear" ? 2500 : 1000,
          useNativeDriver: true,
        }),
      ]).start();
    }

    // Geçmişe ekle (sadece semi ve clear)
    if (clarity !== "unclear") {
      const detection: Detection = {
        id: Date.now().toString(),
        word,
        frequency: paranormalFreq,
        band,
        strength,
        clarity,
        timestamp: Date.now(),
      };
      setDetections((prev) => [detection, ...prev].slice(0, 8));
    }

    // Sonraki tespiti zamanla
    const recoveryTime = clarity === "clear" ? 5000 : clarity === "semi" ? 2000 : 800;
    setTimeout(() => {
      if (isScanningRef.current) {
        setScanState("scanning");
        setSignalStrength(0);
        scheduleNextDetection();
      }
    }, recoveryTime);
  }, [band, speakWord, pickClarity, getWordForClarity]);

  const scheduleNextDetection = useCallback(() => {
    if (detectionTimeoutRef.current) {
      clearTimeout(detectionTimeoutRef.current);
    }
    const clarity = pickClarity();
    const interval = getIntervalForClarity(clarity);

    detectionTimeoutRef.current = setTimeout(() => {
      triggerDetection();
    }, interval);
  }, [pickClarity, getIntervalForClarity, triggerDetection]);

  // ─── Belirsiz arka plan mırıltıları (ek katman) ────────────────────────────

  const scheduleBackgroundMurmur = useCallback(() => {
    if (!isScanningRef.current) return;

    const murmurInterval = 4000 + Math.random() * 8000; // 4-12sn arası
    unclearTimeoutRef.current = setTimeout(() => {
      if (!isScanningRef.current) return;

      // Çok kısık, çok hızlı bir mırıltı - ana tespitlerden bağımsız
      const murmurWord = UNCLEAR_WORDS[Math.floor(Math.random() * UNCLEAR_WORDS.length)];
      Speech.speak(murmurWord, {
        language: "tr-TR",
        pitch: 0.2 + Math.random() * 0.3,
        rate: 1.5 + Math.random() * 1.0,
        volume: 0.15 + Math.random() * 0.1, // Çok kısık
      });

      scheduleBackgroundMurmur(); // Tekrarla
    }, murmurInterval);
  }, []);

  // ─── SCAN CONTROL ──────────────────────────────────────────────────────────

  const startScan = useCallback(() => {
    isScanningRef.current = true;
    setScanState("scanning");
    setSignalStrength(0);
    setElapsedTime(0);
    setCurrentWord("");
    setDetections([]);

    // Kesintisiz beyaz gürültü başlat
    try {
      staticPlayer.loop = true;
      staticPlayer.volume = noiseLevel;
      staticPlayer.play();
    } catch (e) {}

    if (Platform.OS !== "web") {
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);
    }

    // Frekans tarama animasyonu + sweep sesleri
    const bandConfig = BANDS[band];
    let dir = 1;
    let sweepCounter = 0;
    scanIntervalRef.current = setInterval(() => {
      setFrequency((prev) => {
        const speed = bandConfig.step * dir * (0.8 + Math.random() * 1.5);
        let next = prev + speed;
        if (next >= bandConfig.max) {
          dir = -1;
          sweepCounter++;
          if (sweepCounter % 3 === 0) playSweep(); // Her 3 dönüşte sweep
          return bandConfig.max;
        }
        if (next <= bandConfig.min) {
          dir = 1;
          sweepCounter++;
          if (sweepCounter % 3 === 0) playSweep();
          return bandConfig.min;
        }
        return Math.round(next * 10) / 10;
      });
    }, 150);

    // Süre sayacı
    timerIntervalRef.current = setInterval(() => {
      setElapsedTime((prev) => prev + 1);
    }, 1000);

    // İlk tespit zamanla (5-15sn sonra)
    const firstDelay = 5000 + Math.random() * 10000;
    detectionTimeoutRef.current = setTimeout(() => {
      triggerDetection();
    }, firstDelay);

    // Arka plan mırıltıları başlat (3sn sonra)
    setTimeout(() => {
      scheduleBackgroundMurmur();
    }, 3000);
  }, [band, noiseLevel, scheduleNextDetection, playSweep, scheduleBackgroundMurmur]);

  const stopScan = useCallback(() => {
    isScanningRef.current = false;
    setScanState("idle");
    setSignalStrength(0);
    setCurrentWord("");

    // Sesleri durdur
    try { staticPlayer.pause(); } catch (e) {}
    try { sweepPlayer.pause(); } catch (e) {}
    Speech.stop();

    // Tüm interval/timeout'ları temizle
    if (scanIntervalRef.current) { clearInterval(scanIntervalRef.current); scanIntervalRef.current = null; }
    if (timerIntervalRef.current) { clearInterval(timerIntervalRef.current); timerIntervalRef.current = null; }
    if (detectionTimeoutRef.current) { clearTimeout(detectionTimeoutRef.current); detectionTimeoutRef.current = null; }
    if (unclearTimeoutRef.current) { clearTimeout(unclearTimeoutRef.current); unclearTimeoutRef.current = null; }

    if (Platform.OS !== "web") {
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
    }
  }, []);

  // Cleanup
  useEffect(() => {
    return () => {
      isScanningRef.current = false;
      if (scanIntervalRef.current) clearInterval(scanIntervalRef.current);
      if (timerIntervalRef.current) clearInterval(timerIntervalRef.current);
      if (detectionTimeoutRef.current) clearTimeout(detectionTimeoutRef.current);
      if (unclearTimeoutRef.current) clearTimeout(unclearTimeoutRef.current);
      try { staticPlayer.pause(); } catch (e) {}
      try { sweepPlayer.pause(); } catch (e) {}
      Speech.stop();
    };
  }, []);

  // ─── NOISE LEVEL CONTROL ───────────────────────────────────────────────────

  const adjustNoise = (direction: 1 | -1) => {
    setNoiseLevel((prev) => {
      const next = Math.max(0.1, Math.min(0.6, prev + direction * 0.05));
      if (isScanningRef.current) {
        try { staticPlayer.volume = next; } catch (e) {}
      }
      return next;
    });
    if (Platform.OS !== "web") {
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
    }
  };

  // ─── MANUAL FREQUENCY ──────────────────────────────────────────────────────

  const adjustFrequency = (direction: 1 | -1) => {
    if (scanState !== "idle") return;
    const bandConfig = BANDS[band];
    setFrequency((prev) => {
      const next = prev + bandConfig.step * direction * 5;
      return Math.max(bandConfig.min, Math.min(bandConfig.max, Math.round(next * 10) / 10));
    });
    if (Platform.OS !== "web") {
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
    }
  };

  // ─── BAND SWITCH ───────────────────────────────────────────────────────────

  const switchBand = (newBand: Band) => {
    if (scanState !== "idle") return;
    setBand(newBand);
    setFrequency(BANDS[newBand].min);
    if (Platform.OS !== "web") {
      Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Light);
    }
  };

  // ─── HELPERS ────────────────────────────────────────────────────────────────

  const formatFreq = (freq: number, b: Band) => {
    return b === "AM" ? `${Math.round(freq)}` : freq.toFixed(1);
  };

  const formatTime = (seconds: number) => {
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
  };

  const getStrengthColor = (s: number) => {
    if (s > 75) return "#FF4444";
    if (s > 50) return "#FFD700";
    if (s > 25) return "#00FF88";
    return "#4A4A5A";
  };

  const getClarityColor = (c: WordClarity) => {
    if (c === "clear") return "#9B4FDE";
    if (c === "semi") return "#00FF88";
    return "#4A4A5A";
  };

  const getClarityLabel = (c: WordClarity) => {
    if (c === "clear") return "NET";
    if (c === "semi") return "BELİRSİZ";
    return "GÜRÜLTÜ";
  };

  // ─── RENDER ─────────────────────────────────────────────────────────────────

  const isActive = scanState !== "idle";
  const isDetected = scanState === "detected";
  const bandConfig = BANDS[band];

  return (
    <ScreenContainer containerClassName="bg-[#060609]">
      <ScrollView
        style={styles.scrollView}
        contentContainerStyle={styles.scrollContent}
        showsVerticalScrollIndicator={false}
      >
        {/* ─── HEADER ─────────────────────────────────────── */}
        <View style={styles.header}>
          <Text style={styles.title}>FREKANS TARAYICI</Text>
          <View style={styles.headerRow}>
            <Text style={styles.subtitle}>Paranormal Sinyal Avcısı</Text>
            {isActive && (
              <Text style={styles.timer}>{formatTime(elapsedTime)}</Text>
            )}
          </View>
        </View>

        {/* ─── BAND SELECTOR ──────────────────────────────── */}
        <View style={styles.bandRow}>
          {(["AM", "FM"] as Band[]).map((b) => (
            <Pressable
              key={b}
              onPress={() => switchBand(b)}
              style={({ pressed }) => [
                styles.bandBtn,
                band === b && styles.bandBtnActive,
                pressed && { opacity: 0.7 },
              ]}
            >
              <Text style={[styles.bandLabel, band === b && styles.bandLabelActive]}>
                {b}
              </Text>
              <Text style={styles.bandInfo}>
                {BANDS[b].min}–{BANDS[b].max} {BANDS[b].unit}
              </Text>
            </Pressable>
          ))}
        </View>

        {/* ─── FREQUENCY DISPLAY ──────────────────────────── */}
        <Animated.View
          style={[
            styles.freqCard,
            { transform: [{ scale: pulseAnim }] },
            isDetected && styles.freqCardDetected,
          ]}
        >
          <Animated.View style={[styles.glowOverlay, { opacity: glowAnim }]} />

          <Text style={styles.freqBandLabel}>{band} BANT</Text>

          <Text
            style={[styles.freqValue, isDetected && styles.freqValueDetected]}
            numberOfLines={1}
            adjustsFontSizeToFit
          >
            {formatFreq(frequency, band)}
          </Text>

          <Text style={styles.freqUnit}>{bandConfig.unit}</Text>

          {/* Sinyal gücü */}
          {signalStrength > 0 && (
            <View style={styles.strengthRow}>
              <View style={styles.strengthBarBg}>
                {Array.from({ length: 10 }).map((_, i) => (
                  <View
                    key={i}
                    style={[
                      styles.strengthSegment,
                      {
                        backgroundColor:
                          i < Math.ceil(signalStrength / 10)
                            ? getStrengthColor(signalStrength)
                            : "#1A1A2E",
                      },
                    ]}
                  />
                ))}
              </View>
              <Text style={[styles.strengthText, { color: getStrengthColor(signalStrength) }]}>
                {signalStrength}%
              </Text>
            </View>
          )}

          {/* Durum */}
          <View style={styles.statusRow}>
            <View
              style={[
                styles.statusDot,
                {
                  backgroundColor: isDetected ? "#9B4FDE" : isActive ? "#00FF88" : "#333",
                },
              ]}
            />
            <Text style={[styles.statusText, isDetected && { color: "#9B4FDE" }]}>
              {isDetected ? "SİNYAL YAKALANDI" : isActive ? "Taranıyor..." : "Hazır"}
            </Text>
          </View>
        </Animated.View>

        {/* ─── TESPİT EDİLEN KELİME ──────────────────────── */}
        <Animated.View style={[styles.wordContainer, { opacity: wordFadeAnim }]}>
          {currentWord !== "" && (
            <>
              <Text style={[styles.wordText, { color: getClarityColor(currentClarity) }]}>
                "{currentWord}"
              </Text>
              {currentClarity === "clear" && (
                <Text style={styles.wordClarityBadge}>NET SİNYAL</Text>
              )}
            </>
          )}
        </Animated.View>

        {/* ─── SPECTRUM ───────────────────────────────────── */}
        <Animated.View style={[styles.spectrum, { opacity: noiseAnim }]}>
          {Array.from({ length: 28 }).map((_, i) => {
            const h = isActive ? 2 + Math.random() * (isDetected ? 24 : 12) : 2;
            return (
              <View
                key={i}
                style={[
                  styles.specBar,
                  {
                    height: h,
                    backgroundColor: isDetected ? "#9B4FDE" : "#00FF88",
                    opacity: 0.2 + Math.random() * 0.5,
                  },
                ]}
              />
            );
          })}
        </Animated.View>

        {/* ─── NOISE LEVEL ────────────────────────────────── */}
        <View style={styles.noiseLevelRow}>
          <Text style={styles.noiseLevelLabel}>Gürültü</Text>
          <Pressable
            onPress={() => adjustNoise(-1)}
            style={({ pressed }) => [styles.noiseBtn, pressed && { opacity: 0.5 }]}
          >
            <Text style={styles.noiseBtnText}>−</Text>
          </Pressable>
          <View style={styles.noiseLevelBar}>
            <View
              style={[styles.noiseLevelFill, { width: `${(noiseLevel / 0.6) * 100}%` }]}
            />
          </View>
          <Pressable
            onPress={() => adjustNoise(1)}
            style={({ pressed }) => [styles.noiseBtn, pressed && { opacity: 0.5 }]}
          >
            <Text style={styles.noiseBtnText}>+</Text>
          </Pressable>
        </View>

        {/* ─── CONTROLS ───────────────────────────────────── */}
        <View style={styles.controlRow}>
          <Pressable
            onPress={() => adjustFrequency(-1)}
            disabled={isActive}
            style={({ pressed }) => [
              styles.arrowBtn,
              pressed && { opacity: 0.5 },
              isActive && { opacity: 0.2 },
            ]}
          >
            <Text style={styles.arrowText}>−</Text>
          </Pressable>

          <Pressable
            onPress={isActive ? stopScan : startScan}
            style={({ pressed }) => [
              styles.mainBtn,
              isActive && styles.mainBtnActive,
              pressed && { transform: [{ scale: 0.96 }] },
            ]}
          >
            <Text style={[styles.mainBtnIcon, isActive && styles.mainBtnIconActive]}>
              {isActive ? "■" : "▶"}
            </Text>
            <Text
              style={[styles.mainBtnLabel, isActive && styles.mainBtnLabelActive]}
              numberOfLines={1}
            >
              {isActive ? "DURDUR" : "TARA"}
            </Text>
          </Pressable>

          <Pressable
            onPress={() => adjustFrequency(1)}
            disabled={isActive}
            style={({ pressed }) => [
              styles.arrowBtn,
              pressed && { opacity: 0.5 },
              isActive && { opacity: 0.2 },
            ]}
          >
            <Text style={styles.arrowText}>+</Text>
          </Pressable>
        </View>

        {/* ─── DETECTION HISTORY ──────────────────────────── */}
        {detections.length > 0 && (
          <View style={styles.historyCard}>
            <Text style={styles.historyTitle}>Yakalanan Sinyaller</Text>
            {detections.map((d) => (
              <View key={d.id} style={styles.historyRow}>
                <View style={styles.historyLeft}>
                  <Text style={[styles.historyWord, { color: getClarityColor(d.clarity) }]}>
                    "{d.word}"
                  </Text>
                  <Text style={styles.historyMeta}>
                    {formatFreq(d.frequency, d.band)} {BANDS[d.band].unit} • {getClarityLabel(d.clarity)}
                  </Text>
                </View>
                <View style={[styles.historyBadge, { backgroundColor: getStrengthColor(d.strength) }]}>
                  <Text style={styles.historyBadgeText}>{d.strength}%</Text>
                </View>
              </View>
            ))}
          </View>
        )}

        <View style={{ height: 100 }} />
      </ScrollView>
    </ScreenContainer>
  );
}

